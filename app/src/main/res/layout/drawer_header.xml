<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="36dp"
    android:paddingBottom="24dp"
    android:clipToPadding="false"
    android:background="@color/transparent">

    <!-- Branding Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="24dp">
        
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@mipmap/ic_launcher_round"
            android:elevation="0dp"
            android:padding="2dp"
            android:background="@drawable/bg_circle_white_shadow"
            android:contentDescription="App Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aries AI"
                android:textAppearance="@style/Widget.Aries.Sidebar.Title"
                android:letterSpacing="0.02" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="智能手机助手"
                android:textAppearance="@style/Widget.Aries.Sidebar.Subtitle" />
        </LinearLayout>
    </LinearLayout>

    <!-- API Config Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        style="@style/Widget.Aries.Surface.DrawerCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">
                
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_key_24"
                    app:tint="@color/blue_glass_primary" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="API 配置"
                    android:textAppearance="@style/Widget.Aries.Sidebar.SectionTitle" />
            </LinearLayout>

            <EditText
                android:id="@+id/apiInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="输入 API Key"
                android:background="@drawable/bg_input_field_flat"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:inputType="textNoSuggestions|textVisiblePassword"
                style="@style/Widget.Aries.Sidebar.EditText"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_public_24"
                    app:tint="@color/m3_on_surface" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="使用第三方 OpenAI 兼容 API"
                    android:textAppearance="@style/Widget.Aries.Sidebar.SectionTitle" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swUseThirdPartyApi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/apiThirdPartyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Base URL"
                        android:textAppearance="@style/Widget.Aries.Sidebar.Caption"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/apiBaseUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="42dp"
                        android:background="@drawable/bg_input_field_flat"
                        android:hint="https://api.example.com/v1"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:inputType="textUri"
                        style="@style/Widget.Aries.Sidebar.EditText"
                        android:layout_marginBottom="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Model"
                        android:textAppearance="@style/Widget.Aries.Sidebar.Caption"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/apiModelInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="42dp"
                        android:background="@drawable/bg_input_field_flat"
                        android:hint="glm-4-flash"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:inputType="textNoSuggestions"
                        style="@style/Widget.Aries.Sidebar.EditText" />
                </LinearLayout>
            </LinearLayout>

            <!-- Get API Key Link -->
            <TextView
                android:id="@+id/btnGetApiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="获取您的 API Key >"
                android:textAppearance="@style/TextAppearance.Aries.Link"
                android:paddingVertical="4dp"
                android:paddingEnd="4dp"
                android:background="?attr/selectableItemBackground"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckApi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="验证连接"
                android:textAppearance="@style/TextAppearance.Aries.Label.Medium"
                android:textColor="@color/m3_on_primary"
                app:backgroundTint="@color/blue_glass_primary"
                app:cornerRadius="24dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_check_circle_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <TextView
                android:id="@+id/apiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未检查"
                android:textAppearance="@style/Widget.Aries.Sidebar.Caption"
                android:gravity="center"
                android:paddingTop="10dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
