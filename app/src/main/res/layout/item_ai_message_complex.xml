<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:layout_marginEnd="0dp"
    android:background="@drawable/bg_glass_pane"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/thinking_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@color/thinking_background"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/thinking_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已思考"
                android:textAppearance="@style/TextAppearance.Aries.Thinking.Header" />

            <TextView
                android:id="@+id/thinking_indicator_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text=" ⌄"
                android:textAppearance="@style/TextAppearance.Aries.Thinking.Header" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/thinking_content_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="@color/m3_outline_variant" />

            <TextView
                android:id="@+id/thinking_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="24dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text=""
                android:textAppearance="@style/TextAppearance.Aries.Thinking.Content"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/ai_author_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:letterSpacing="0.03"
        android:text="Aries AI"
        android:textAppearance="@style/TextAppearance.Aries.Message.Author"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textAppearance="@style/TextAppearance.Aries.Message.Content"
        android:textIsSelectable="true"
        android:lineSpacingMultiplier="1.5" />

    <LinearLayout
        android:id="@+id/action_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="4dp"
            android:background="@color/m3_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_copy"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_button_oval"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_content_copy_24"
                    app:tint="@color/m3_on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="复制"
                    android:textAppearance="@style/TextAppearance.Aries.Message.Action" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_action_button_oval"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/iv_retry_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_refresh_24"
                    app:tint="@color/m3_on_surface_variant" />

                <TextView
                    android:id="@+id/tv_retry_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/retry"
                    android:textAppearance="@style/TextAppearance.Aries.Message.Action" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
