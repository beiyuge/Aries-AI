<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="0dp"
    android:background="@drawable/bg_user_bubble_water"
    android:orientation="vertical">

    <TextView
        android:id="@+id/user_author_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="我"
        android:textAppearance="@style/TextAppearance.Aries.Thinking.Header"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4dp"
        android:textAppearance="@style/TextAppearance.Aries.Message.Content"
        android:textIsSelectable="true" />

</LinearLayout>
